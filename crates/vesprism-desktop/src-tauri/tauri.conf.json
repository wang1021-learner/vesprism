{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesprism",
  "version": "0.1.0",
  "identifier": "com.vesprism.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:9527",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "title": "Vesprism",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "freezePrototype": false,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "worker-src": "'self' blob:",
        "child-src": "blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:9527",
        "script-src": "'self' 'unsafe-inline' http://127.0.0.1:9527",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:9527",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http://127.0.0.1:9527",
        "font-src": "'self' data: http://127.0.0.1:9527",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:9527 ws://127.0.0.1:9527",
        "worker-src": "'self' blob:",
        "child-src": "blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/vesprism-paste/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}